{
  "description": "Supervised project lifecycle hooks. Installation does not imply activation.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "supervised adapter hook --adapter codex",
            "commandWindows": "supervised.exe adapter hook --adapter codex",
            "additionalContextLimit": 2500,
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "supervised adapter hook --adapter codex",
            "commandWindows": "supervised.exe adapter hook --adapter codex",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "supervised adapter hook --adapter codex",
            "commandWindows": "supervised.exe adapter hook --adapter codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "supervised adapter hook --adapter codex",
            "commandWindows": "supervised.exe adapter hook --adapter codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "supervised adapter hook --adapter codex",
            "commandWindows": "supervised.exe adapter hook --adapter codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "supervised adapter hook --adapter codex",
            "commandWindows": "supervised.exe adapter hook --adapter codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "supervised adapter hook --adapter codex",
            "commandWindows": "supervised.exe adapter hook --adapter codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
